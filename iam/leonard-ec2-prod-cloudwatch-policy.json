{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateAndDescribeLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DescribeLogGroups"
      ],
      "Resource": "arn:aws:logs:us-east-1:439475769170:log-group:/leonard/*"
    },
    {
      "Sid": "WriteLogStreams",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:us-east-1:439475769170:log-group:/leonard/*:*"
    }
  ]
}
